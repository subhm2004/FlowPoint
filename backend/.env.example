# Server
PORT=8000
NODE_ENV=development

# API prefix (Express mounts routes under this path)
BASE_PATH=/api

# MongoDB — Atlas or local
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>

# JWT (use a long random secret in production, e.g. openssl rand -base64 32)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS: allowed browser origin(s). Comma-separated for multiple (no spaces after commas is fine).
# Example: production site + local Vite when the SPA calls this API from localhost:
#   FRONTEND_ORIGIN=https://your-app.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ─── Google OAuth (optional) ───
# Leave these unset and Google sign-in is simply disabled; the rest of the API still boots.
# Credentials: https://console.cloud.google.com/apis/credentials
#
# GOOGLE_CALLBACK_URL is the *backend* route below, and it must match an "Authorized
# redirect URI" in the Google console character for character. The callback lives on the
# API, not the SPA, because trading the code for a token needs GOOGLE_CLIENT_SECRET —
# that value must never reach a browser.
#
#   local:      http://localhost:8000/api/auth/callback/google
#   production: https://your-service.onrender.com/api/auth/callback/google
#
# FRONTEND_GOOGLE_CALLBACK_URL is the SPA page we bounce back to afterwards, carrying the
# app's own JWT. It needs no Google registration — only the redirect URI above does.
#
#   local:      http://localhost:5173/auth/google/callback
#   production: https://your-app.vercel.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/callback/google
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
