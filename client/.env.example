# Vite picks the file by mode, so each mode gets its own — never quote the values.
#
#   npm run dev     -> .env.development   VITE_API_BASE_URL=http://localhost:8000/api
#                      Browser calls the local backend directly. Start it first:
#                      cd backend && npm run dev   (backend/.env has PORT=8000)
#                      Cross-origin (5173 -> 8000), but backend CORS already allows
#                      any localhost port and auth is a Bearer token, so it just works.
#
#                      No-CORS alternative — same-origin via the Vite proxy:
#                        VITE_API_BASE_URL=/api
#                      vite.config.ts then forwards /api to VITE_DEV_PROXY_TARGET
#                      (default http://127.0.0.1:8000).
#
#   npm run build   -> .env.production    VITE_API_BASE_URL=https://your-service.onrender.com/api
#                      Must be the full URL ending in /api.
#
# Do not add a plain `.env`: it loads in every mode and shadows the two above.
#
# Hosted builds (Vercel) never see these files — they are gitignored. Set
# VITE_API_BASE_URL in the host dashboard and redeploy; Vite bakes it in at
# build time, so a running deploy will not pick up a changed value.

VITE_API_BASE_URL=http://localhost:8000/api
